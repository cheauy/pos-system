# Use a long random secret. Never expose this with a NEXT_PUBLIC_ prefix.
WEBHOOK_SECRET=
# Optional legacy name (used only when WEBHOOK_SECRET is empty); existing aliases keep working.
IMPROVMX_WEBHOOK_SECRET=
# Configure ?secret=YOUR_SECRET or x-webhook-secret. If neither variable is set, POST authentication is disabled.
# Shared Redis REST storage is required for receiving real email on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace injects KV_REST_API_URL and KV_REST_API_TOKEN instead; both names are supported.
